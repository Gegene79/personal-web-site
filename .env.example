# Configuración de AEMET para el backend
AEMET_API_KEY=YOUR_AEMET_API_KEY
AEMET_LOCATION_CODE=08202

# Ruta de datos de Elasticsearch en el equipo anfitrión.
# En local puede ser relativa al proyecto; en Linux usa una ruta absoluta, por ejemplo:
# ES_DATA_PATH=/srv/personal-web-site/data/elasticsearch
ES_DATA_PATH=./.data/elasticsearch
